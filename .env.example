# Sao chép file này thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env lên GitHub.

# ===== Bắt buộc =====
DISCORD_TOKEN=
GEMINI_API_KEY=

# ===== Gemini =====
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_OUTPUT_TOKENS=1024
# Mức suy nghĩ: minimal | low | medium | high (để trống = mặc định của model)
THINKING_LEVEL=
# Cách cũ, chỉ dùng khi THINKING_LEVEL để trống
THINKING_BUDGET=
# Để trống = mặc định của model (Google khuyến nghị không chỉnh với Gemini 3.x)
GEMINI_TEMPERATURE=
GEMINI_TIMEOUT=30
GEMINI_CONCURRENCY=4
GEMINI_429_RETRY_SECONDS=3

# ===== Hội thoại & ảnh =====
MAX_HISTORY_TURNS=10
HISTORY_RETENTION_DAYS=30
MAX_IMAGES=4
MAX_IMAGE_MB=8

# ===== Discord =====
# Giới hạn bot chỉ chạy ở các server này (ID, cách nhau bằng dấu phẩy). Để trống = không giới hạn.
ALLOWED_GUILD_IDS=
# Kênh Auto-Chat có sẵn khi khởi động (ID, cách nhau bằng dấu phẩy)
AUTO_CHAT_CHANNEL_IDS=
# Role được coi là Admin của bot (ngoài Owner / quyền Administrator)
ADMIN_ROLE_IDS=
# Đặt true nếu đã bật SERVER MEMBERS INTENT trong Discord Developer Portal
MEMBERS_INTENT=false
SYNC_ON_START=true
STATUS_TYPE=playing
STATUS_TEXT=Where Winds Meet
# Mỗi người chỉ kích hoạt Auto-Chat 1 lần / N giây trong một kênh (0 = tắt)
AUTO_CHAT_COOLDOWN_SECONDS=3

# ===== Reminder =====
REMINDER_GRACE_MINUTES=10
MAX_REMINDERS_PER_USER=20
MAX_REMINDER_LENGTH=1500
# Xóa reminder đã tắt sau N ngày (0 = giữ mãi)
REMINDER_RETENTION_DAYS=30

# ===== Database =====
# Trên Railway nên trỏ vào Volume, ví dụ /data/conversations.db
DB_PATH=conversations.db

# ===== Web dashboard =====
DASHBOARD_ENABLED=false
# Chạy trên Railway/Docker cần 0.0.0.0; chạy máy cá nhân giữ 127.0.0.1
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Mật khẩu dài ít nhất 12 ký tự
DASHBOARD_PASSWORD=
# Đặt true khi truy cập qua HTTPS (Railway, reverse proxy)
DASHBOARD_SECURE_COOKIE=false
