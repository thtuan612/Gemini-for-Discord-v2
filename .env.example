# Sao chép file này thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env lên GitHub.

# ===== Bắt buộc =====
DISCORD_TOKEN=
# Bắt buộc khi GEMINI_ENABLED=true
GEMINI_API_KEY=

# ===== Gemini =====
# Bật/tắt provider Gemini (tắt thì không cần GEMINI_API_KEY)
GEMINI_ENABLED=true
# Model chính. Cũng có thể điền nhiều model cách nhau bằng dấu phẩy: model đầu là chính, còn lại là dự phòng
GEMINI_MODEL=gemini-3.5-flash-lite
# Model dự phòng (tùy chọn), cách nhau bằng dấu phẩy, thử lần lượt khi model trước gặp quota / 429 / lỗi tạm thời
# (THINKING_LEVEL / THINKING_BUDGET / GEMINI_TEMPERATURE áp dụng cho MỌI model Gemini ở đây;
#  nếu model dự phòng không hỗ trợ tham số đó, hãy để trống chúng.)
GEMINI_FALLBACK_MODELS=
MAX_OUTPUT_TOKENS=1024
# Mức suy nghĩ: minimal | low | medium | high (để trống = mặc định của model)
THINKING_LEVEL=
# Cách cũ, chỉ dùng khi THINKING_LEVEL để trống
THINKING_BUDGET=
# Để trống = mặc định của model (Google khuyến nghị không chỉnh với Gemini 3.x)
GEMINI_TEMPERATURE=
GEMINI_TIMEOUT=30
GEMINI_CONCURRENCY=4
GEMINI_429_RETRY_SECONDS=3

# ===== Literouter (OpenAI-compatible) =====
# Mặc định TẮT. Bật bằng true và điền LITEROUTER_API_KEY.
LITEROUTER_ENABLED=false
LITEROUTER_API_KEY=
LITEROUTER_BASE_URL=https://literouter.fun/api/v1
# Model mặc định. Để trống = tự dùng model đầu tiên trong danh sách lấy từ /models
LITEROUTER_MODEL=
LITEROUTER_TIMEOUT=30
# Làm mới danh sách model từ /models mỗi N giờ (cache lưu file, dùng khi API tạm ngừng)
LITEROUTER_MODELS_REFRESH_HOURS=6
# Để trống = literouter_models.json cạnh file DB_PATH
LITEROUTER_CACHE_PATH=

# Thứ tự thử các provider đang bật (provider không có trong danh sách được xếp sau cùng)
AI_PROVIDER_ORDER=gemini,literouter

# ===== Hội thoại & ảnh =====
MAX_HISTORY_TURNS=10
HISTORY_RETENTION_DAYS=30
# Số tin nhắn gần nhất trong kênh chat bot sẽ đọc để nắm ngữ cảnh cuộc trò chuyện (0 = tắt)
CHANNEL_HISTORY_LIMIT=5
# /chat mặc định gửi 5 tin nhắn gần nhất trong kênh tới AI để hiểu mạch hội thoại
CHAT_INCLUDE_CHANNEL_CONTEXT=true
MAX_IMAGES=4
MAX_IMAGE_MB=8

# ===== Discord =====
# Giới hạn bot chỉ chạy ở các server này (ID, cách nhau bằng dấu phẩy). Để trống = không giới hạn.
ALLOWED_GUILD_IDS=
# Kênh Auto-Chat có sẵn khi khởi động (ID, cách nhau bằng dấu phẩy)
AUTO_CHAT_CHANNEL_IDS=
# Role được coi là Admin của bot (ngoài Owner / quyền Administrator)
ADMIN_ROLE_IDS=
# Đặt true nếu đã bật SERVER MEMBERS INTENT trong Discord Developer Portal
MEMBERS_INTENT=false
SYNC_ON_START=true
STATUS_TYPE=playing
STATUS_TEXT=Where Winds Meet
# Mỗi người chỉ kích hoạt Auto-Chat 1 lần / N giây trong một kênh (0 = tắt)
AUTO_CHAT_COOLDOWN_SECONDS=3

# ===== Database =====
# Trên Railway nên trỏ vào Volume, ví dụ /data/conversations.db
DB_PATH=conversations.db
